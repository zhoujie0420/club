[Unit]
Description=HOLE CLUB pull GitHub club-test release
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
WorkingDirectory=%h/club-test
ExecStart=%h/club-watch/watch-release.sh
Nice=10
StandardOutput=append:%h/club-test/watch.log
StandardError=append:%h/club-test/watch.log
